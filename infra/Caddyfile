{
  admin off
}
{$SITE_ADDRESS:localhost} {
  {$TLS_MODE:tls internal}
  request_body {
    max_size 11MB
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    -Server
  }
  reverse_proxy web:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }
}
