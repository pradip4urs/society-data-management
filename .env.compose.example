# Copy to .env on the deployment host. Shell-compatible; no secret values here.
COMPOSE_PROJECT_NAME=society
RELEASE_TAG=local
DEPLOYMENT_MODE=local
SITE_ADDRESS=localhost
APP_URL=https://localhost
DATA_ROOT=./data
SECRETS_DIR=./secrets
BACKUP_ROOT=./backups
# age public recipient only; keep the private identity on a separate trusted machine.
BACKUP_RECIPIENT=
BACKUP_RETENTION_DAYS=30
